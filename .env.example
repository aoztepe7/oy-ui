# oy-service base URL (server-side only, never exposed to the browser)
API_URL=http://localhost:8080

# Shared secret; oy-service sends it in the x-revalidate-secret header
REVALIDATE_SECRET=change-me

# Public site URL (canonical links, sitemap, OpenGraph)
SITE_URL=https://okulumyeryuzu.com

# Admin panel origins allowed to embed the visual editor preview (/onizleme/*), comma-separated.
# Read at runtime: frame-ancestors header (proxy.ts) and the postMessage origin check.
PANEL_ORIGINS=http://localhost:3001,http://localhost:5173

# Optional extra image hosts for next/image, comma-separated (read at build time).
# localhost:8080 and service.okulumyeryuzu.com are always allowed.
NEXT_PUBLIC_MEDIA_HOST=
